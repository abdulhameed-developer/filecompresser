{
  "name": "filecompresser",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/prepare-static-assets.mjs && next dev -H 0.0.0.0",
    "build": "node scripts/prepare-static-assets.mjs && next build",
    "start": "node scripts/serve-static.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "bash scripts/verify.sh",
    "check:public": "node scripts/check-public.mjs",
    "setup:cms": "node scripts/setup-cms.mjs",
    "dev:cms": "node scripts/check-cms-setup.mjs && node scripts/prepare-static-assets.mjs && tinacms dev --noTelemetry -c \"next dev -H 0.0.0.0\"",
    "build:cms": "node scripts/check-cms-setup.mjs && tinacms build --noTelemetry && npm run build",
    "build:cms:local": "node scripts/check-cms-setup.mjs && tinacms build --local --skip-cloud-checks --noTelemetry -c \"npm run build\"",
    "check:export": "node scripts/check-export.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "browser-image-compression": "^2.0.2",
    "fflate": "^0.8.3",
    "next": "^16.4.5",
    "pdf-lib": "^1.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.29",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.2",
    "vite": "8.3.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

 // Default desktop actions stay unchanged; the optional touch run uses real
 // emulated tap events rather than claiming mouse clicks exercise touch input.
 const activate = locator => touchEmulation ? locator.tap() : locator.click()
+// BiDi's fill() main-world value setter bypasses React19 change tracking.
+// Exact generated React19 and actual L controls prove native key input works.
+// Keep each original requested string and every application assertion intact.
+async function enterCustomMaximumWithNativeKeys(locator, value) {
+  assert.equal(await locator.getAttribute('type'), 'number')
+  await locator.click()
+  await locator.press('Control+A')
+  await locator.press('Backspace')
+  await locator.pressSequentially(value)
+  assert.equal(await locator.inputValue(), value, 'Native input must preserve the exact requested numeric draft')
+}

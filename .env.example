# Safe local defaults. Copy to .env for TinaCMS (not .env.local).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_INDEXING=false

# TinaCloud: get these from your own project dashboard. Never commit .env.
NEXT_PUBLIC_TINA_CLIENT_ID=e80a2716-65ae-4124-a250-85a481310f9a
TINA_TOKEN=
NEXT_PUBLIC_TINA_BRANCH=main

# Production on Cloudflare Pages (set there, not here):
# NEXT_PUBLIC_SITE_URL=https://filecompresser.com
# NEXT_PUBLIC_ENABLE_INDEXING=true
# Preview builds: NEXT_PUBLIC_ENABLE_INDEXING=false

# Optional search-property verification tokens, never full HTML tags.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
